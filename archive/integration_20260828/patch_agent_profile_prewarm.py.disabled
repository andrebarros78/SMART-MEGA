from pathlib import Path
p=Path('smart_signal_agent.py')
s=p.read_text(encoding='utf-8')
old="""        total_challenger_hits = 0\n        rows = []\n        for t in range(self.start, len(draws)):\n"""
new="""        # Causal unsupervised prewarm: profile drift may use only signal vectors available before OOS start.\n        # No result/label is consumed here, so predictive evaluation remains untouched.\n        for t in range(1, self.start):\n            warm_sc = {n: pre[n][t] for n in names}\n            for n in names:\n                self.states[n].update_profile(warm_sc[n])\n        total_challenger_hits = 0\n        rows = []\n        for t in range(self.start, len(draws)):\n"""
if old not in s: raise SystemExit('anchor not found')
s=s.replace(old,new)
p.write_text(s,encoding='utf-8')
