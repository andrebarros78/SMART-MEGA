from pathlib import Path
p=Path(__file__).resolve().parents[1]/'smart_contextual_meta_weights.py'
s=p.read_text(encoding='utf-8-sig')
old="        members = [n for n in arrays if families[n] == fam]\n        if not members:\n            raise ValueError('empty family is invalid')\n        fam_means[fam] = np.mean([arrays[n] for n in members], axis=0)\n"
new="        members = [n for n in arrays if families[n] == fam]\n        fam_means[fam] = np.mean([arrays[n] for n in members], axis=0)\n"
assert old in s
p.write_text(s.replace(old,new),encoding='utf-8')
print('REMOVED_DEAD_BRANCH')
