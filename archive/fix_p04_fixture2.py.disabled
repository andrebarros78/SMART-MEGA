from pathlib import Path
p=Path('test_smart_signal_marginal_utility.py'); s=p.read_text(encoding='utf-8-sig')
s=s.replace("led['events'].append(dict(led['events'][-1])); cc.write_ledger(lp,led)", "marg=[x for x in led['events'] if x.get('event_type')=='MARGINAL_UTILITY'][0]; led['events'].append(dict(marg)); cc.write_ledger(lp,led)")
p.write_text(s,encoding='utf-8'); print('fixture2 updated')