from pathlib import Path
import hashlib, shutil, json

root = Path(__file__).resolve().parent
p = root / 'test_smart_canonical_result_store_reconcile.py'
raw = p.read_bytes()
before = hashlib.sha256(raw).hexdigest()
text = raw.decode('utf-8-sig')
nl = '\r\n' if '\r\n' in text else '\n'
old = '''def test_real_canonical_store_advanced_through_adjudicated_3054_and_freeze_unchanged():
    _, contests = load_draws(ROOT / "Mega-Sena.xlsx")
    values = [int(x) for x in contests]
    assert values[-1] == 3054
    assert values == list(range(values[0], 3055))
    assert cr.sha256_file(ROOT / "SMART_3054_CHAMPION_CHALLENGER_FREEZE.v2.json") == FREEZE_SHA
    proof = __import__("json").loads((ROOT / "SMART_CANONICAL_RESULT_STORE_RECONCILIATION_3053.json").read_text(encoding="utf-8"))
    assert proof["final_status"] == "PASS"
    assert proof["result_store_ready_for_next_contest"] is True
    assert proof["freeze_3054_unchanged"] is True
'''
new = '''def test_real_canonical_store_tracks_latest_completed_epoch_and_preserves_prior_freeze():
    _, contests = load_draws(ROOT / "Mega-Sena.xlsx")
    values = [int(x) for x in contests]
    assert values[-1] == 3055
    assert values == list(range(values[0], 3056))
    assert cr.sha256_file(ROOT / "SMART_3054_CHAMPION_CHALLENGER_FREEZE.v2.json") == FREEZE_SHA

    prior = __import__("json").loads((ROOT / "SMART_CANONICAL_RESULT_STORE_RECONCILIATION_3053.json").read_text(encoding="utf-8"))
    assert prior["final_status"] == "PASS"
    assert prior["result_store_ready_for_next_contest"] is True
    assert prior["freeze_3054_unchanged"] is True

    latest = __import__("json").loads((ROOT / "SMART_CANONICAL_HISTORY_ADVANCE_3055.json").read_text(encoding="utf-8"))
    assert latest["status"] == "PASS"
    assert latest["target_contest"] == 3055
    assert latest["canonical_max_after"] == 3055
    assert latest["ready_for_next_target"] == 3056
    assert latest["canonical_prefix_preserved"] is True
    assert latest["future_information_used"] is False
    assert latest["retroactive_rewrite"] is False
'''
old = old.replace('\n', nl)
new = new.replace('\n', nl)
if old not in text:
    raise SystemExit('STALE_TEST_CONTEXT_NOT_FOUND')
text2 = text.replace(old, new, 1)
if text2 == text:
    raise SystemExit('NO_CHANGE')
archive = root / 'SMART_STATE_ARCHIVE' / 'b2-evolution-20260910'
archive.mkdir(parents=True, exist_ok=True)
bak = archive / f'{p.name}.{before}.bak'
if not bak.exists():
    bak.write_bytes(raw)
encoded = text2.encode('utf-8')
tmp = p.with_name(p.name + '.d016.tmp')
tmp.write_bytes(encoded)
tmp.replace(p)
after = hashlib.sha256(p.read_bytes()).hexdigest()
print(json.dumps({'before_sha256': before, 'after_sha256': after, 'backup': str(bak.relative_to(root)).replace('\\','/'), 'newline': 'CRLF' if nl == '\r\n' else 'LF'}))
